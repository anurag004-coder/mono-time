# ========================================================
# MONO TIME - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Application Details
PROJECT_NAME="Mono Time - Autonomous Multi-Modal Sales & Clienteling System"
ENVIRONMENT="development" # Set to "production" in live deployment

# Database Connection (SQLite Default)
DATABASE_URL="sqlite:///./sales_agent.db"

# --------------------------------------------------------
# Admin Authentication Credentials (Required for /admin)
# --------------------------------------------------------
# Set the admin username
ADMIN_USERNAME="admin"

# Generate with: node scripts/hash-password.js OR python scripts/hash_password.py
ADMIN_PASSWORD_HASH="$2b$12$EXAMPLE_BCRYPT_HASH_PASTE_HERE"

# Long random string for session signing (e.g. openssl rand -hex 32)
SESSION_SECRET="generate_a_long_random_secret_string_for_production"

# --------------------------------------------------------
# Google Gemini & Vector DB API Keys (Optional)
# --------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="sales-agent-products"

# --------------------------------------------------------
# Promotion & Observer Parameters
# --------------------------------------------------------
HIGH_VALUE_THRESHOLD_INR=2000
EXIT_INTENT_DWELL_SECONDS=120
DEFAULT_DISCOUNT_PERCENT=10
DEFAULT_COUPON_CODE="MONOTIME10"

